# Common
NODE_ENV=development
# Local only: 127.0.0.1. Container/server network: 0.0.0.0.
HOST=127.0.0.1
PORT=8000
# Used only in production to build the public URL: https://api.example.com.
DOMAIN=api.example.com
# Optional. Defaults to debug in development and info in production.
LOG_LEVEL=debug
# Response timeout in minutes.
RESPONSE_TIMEOUT=5

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_AUTH_SOURCE=admin
# Optional. When set, the app connects directly to this MongoDB URI and ignores the DB_* values for the connection URI.
DB_URI=

# Socket.IO admin UI (Basic Auth)
# The password is provided in plain text here and hashed by the app on boot.
SOCKET_ADMIN_USERNAME=your_socket_admin_username
SOCKET_ADMIN_PASSWORD=your_socket_admin_password

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=12h

# Cors
CORS_ORIGIN=*

# Rate limit
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=500

# HTTP payload
MAX_PAYLOAD_SIZE=8 #MiB
